Source: "C:\Users\Administrator\Desktop\james ai\dist\James AI\_internal\*"; DestDir: "{app}\_internal"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{autoprograms}\James AI"; Filename: "{app}\James AI.exe"
Name: "{autodesktop}\James AI"; Filename: "{app}\James AI.exe"

[Run]
Filename: "{app}\James AI.exe"; Description: "Launch James AI"; Flags: postinstall nowait