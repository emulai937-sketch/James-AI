[Setup]
AppName=James AI
AppVersion=1.0.0
AppPublisher=James
DefaultDirName={autopf}\James AI
DefaultGroupName=James AI
OutputDir={userdesktop}
OutputBaseFilename=James AI Setup
Compression=lzma
SolidCompression=yes
WizardStyle=modern

[Files]
